{
  "name": "@aquamind/localization",
  "version": "0.1.0",
  "private": true,
  "description": "AquaMind dil dosyaları, dile göre tarih ve sayı biçimi, birim dönüşümü (web ve ileride telefon uygulaması ortak kullanır)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./engine": {
      "types": "./src/engine.ts",
      "default": "./src/engine.ts"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "default": "./src/catalog.ts"
    },
    "./catalog-segments": {
      "types": "./src/catalog-segments.ts",
      "default": "./src/catalog-segments.ts"
    },
    "./care": {
      "types": "./src/care.ts",
      "default": "./src/care.ts"
    },
    "./species-care": {
      "types": "./src/species-care.ts",
      "default": "./src/species-care.ts"
    },
    "./equipment": {
      "types": "./src/equipment.ts",
      "default": "./src/equipment.ts"
    },
    "./diseases": {
      "types": "./src/diseases.ts",
      "default": "./src/diseases.ts"
    },
    "./plant-warnings": {
      "types": "./src/plant-warnings.ts",
      "default": "./src/plant-warnings.ts"
    },
    "./privacy": {
      "types": "./src/privacy.ts",
      "default": "./src/privacy.ts"
    }
  },
  "sideEffects": false
}
