{
  "name": "aquamind",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:health": "node scripts/test-health.cjs",
    "test:catalog-flow": "node scripts/test-catalog-flow.cjs",
    "audit:catalog": "node scripts/audit-catalog.cjs",
    "test": "vitest run",
    "verify": "tsc --noEmit && node scripts/test-catalog-flow.cjs && node scripts/test-health.cjs && node scripts/audit-catalog.cjs && vitest run && next build"
  },
  "dependencies": {
    "@aquamind/compatibility-engine": "workspace:*",
    "@aquamind/domain": "workspace:*",
    "@fontsource-variable/manrope": "^5.2.6",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
